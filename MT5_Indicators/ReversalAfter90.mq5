//+------------------------------------------------------------------+
//|                                             ReversalAfter90.mq5   |
//|                            90-Candle Hold Reversal Indicator      |
//|                                                                   |
//|  STRATEGY                                                         |
//|  --------                                                         |
//|  The indicator continuously watches price and tracks the extreme  |
//|  high and the extreme low of the current run (these levels are    |
//|  NOT drawn on the chart).                                         |
//|                                                                   |
//|  SELL side (top):                                                 |
//|    * A candle's HIGH (wick included) becomes the marked top as    |
//|      soon as the following candle fails to break above it.        |
//|    * From that top we count candles forward. Every one of the     |
//|      next N candles must stay BELOW the marked high.              |
//|    * If any candle breaks above the high, the old top is          |
//|      invalidated and the new, higher candle becomes the top       |
//|      (the count restarts from there).                             |
//|    * When N candles have closed without breaking the high, the    |
//|      count completes and a reversal-DOWN signal is printed on     |
//|      the completing candle.                                       |
//|                                                                   |
//|  BUY side (bottom): the exact mirror using candle LOWs.           |
//|                                                                   |
//|  Only the confirmed reversal signal is shown (arrow + optional    |
//|  alerts). The tracked high/low levels themselves stay hidden.     |
//+------------------------------------------------------------------+
#property copyright "Generated by Claude Code"
#property version   "1.00"
#property indicator_chart_window
#property indicator_buffers 2
#property indicator_plots   2

//--- plot: Sell (reversal down) arrow
#property indicator_label1  "SellReversal"
#property indicator_type1   DRAW_ARROW
#property indicator_color1  clrTomato
#property indicator_width1  2

//--- plot: Buy (reversal up) arrow
#property indicator_label2  "BuyReversal"
#property indicator_type2   DRAW_ARROW
#property indicator_color2  clrDodgerBlue
#property indicator_width2  2

//+------------------------------------------------------------------+
//| Inputs                                                           |
//+------------------------------------------------------------------+
input int    InpBarsToConfirm = 90;      // Candles the extreme must hold before signalling
input bool   InpEnableSell     = true;   // Watch tops (reversal-down signals)
input bool   InpEnableBuy      = true;   // Watch bottoms (reversal-up signals)
input double InpArrowOffsetPts = 20;     // Arrow gap from the candle (in points)
input int    InpSellArrowCode  = 234;    // Wingdings code for the down/sell arrow
input int    InpBuyArrowCode   = 233;    // Wingdings code for the up/buy arrow
input bool   InpShowLevelLine  = false;  // Draw a short line at the confirmed extreme
input bool   InpAlertPopup     = true;   // Popup + sound alert on a new signal
input bool   InpAlertPush      = false;  // Push notification to MT5 mobile
input bool   InpAlertEmail     = false;  // Email alert on a new signal

//+------------------------------------------------------------------+
//| Buffers                                                          |
//+------------------------------------------------------------------+
double SellBuffer[];
double BuyBuffer[];

//+------------------------------------------------------------------+
//| Persistent scan state (kept between OnCalculate calls)           |
//+------------------------------------------------------------------+
int      g_computedBars = 0;        // number of closed bars already processed

// SELL / top tracking
double   g_peakHigh      = 0.0;
int      g_peakBar       = -1;
int      g_barsSincePeak = 0;
bool     g_sellFired     = false;

// BUY / bottom tracking
double   g_troughLow      = 0.0;
int      g_troughBar      = -1;
int      g_barsSinceTrough = 0;
bool     g_buyFired       = false;

datetime g_lastSellAlert = 0;       // dedupe alerts
datetime g_lastBuyAlert  = 0;

//+------------------------------------------------------------------+
//| Reset all scan state                                             |
//+------------------------------------------------------------------+
void ResetState()
{
   g_computedBars    = 0;
   g_peakHigh        = 0.0;
   g_peakBar         = -1;
   g_barsSincePeak   = 0;
   g_sellFired       = false;
   g_troughLow       = 0.0;
   g_troughBar       = -1;
   g_barsSinceTrough = 0;
   g_buyFired        = false;
}

//+------------------------------------------------------------------+
//| Initialization                                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   SetIndexBuffer(0, SellBuffer, INDICATOR_DATA);
   SetIndexBuffer(1, BuyBuffer,  INDICATOR_DATA);

   // Non-series: index 0 = oldest bar (matches OnCalculate arrays)
   ArraySetAsSeries(SellBuffer, false);
   ArraySetAsSeries(BuyBuffer,  false);

   PlotIndexSetInteger(0, PLOT_ARROW, InpSellArrowCode);
   PlotIndexSetInteger(1, PLOT_ARROW, InpBuyArrowCode);

   PlotIndexSetDouble(0, PLOT_EMPTY_VALUE, 0.0);
   PlotIndexSetDouble(1, PLOT_EMPTY_VALUE, 0.0);

   PlotIndexSetString(0, PLOT_LABEL, "SellReversal");
   PlotIndexSetString(1, PLOT_LABEL, "BuyReversal");

   if(InpBarsToConfirm < 1)
   {
      Print("ReversalAfter90: InpBarsToConfirm must be >= 1");
      return(INIT_PARAMETERS_INCORRECT);
   }

   IndicatorSetString(INDICATOR_SHORTNAME,
                      StringFormat("Reversal-After-%d", InpBarsToConfirm));

   ResetState();
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Remove any objects we created                                    |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   ObjectsDeleteAll(0, "RA90_");
}

//+------------------------------------------------------------------+
//| Draw a short level line at a confirmed extreme (optional)        |
//+------------------------------------------------------------------+
void DrawLevel(const string tag, datetime t1, datetime t2, double price, color clr)
{
   if(!InpShowLevelLine)
      return;
   string name = "RA90_" + tag + "_" + IntegerToString((int)t1);
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_TREND, 0, t1, price, t2, price);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_STYLE, STYLE_DOT);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
   ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
}

//+------------------------------------------------------------------+
//| Fire alerts once per signal                                      |
//+------------------------------------------------------------------+
void FireAlert(bool isSell, datetime barTime, double level)
{
   string dir = isSell ? "SELL (reversal down)" : "BUY (reversal up)";
   string msg = StringFormat("%s %s: %s held %d candles @ %s",
                             _Symbol, EnumToString((ENUM_TIMEFRAMES)_Period),
                             dir, InpBarsToConfirm,
                             DoubleToString(level, _Digits));

   if(InpAlertPopup) Alert(msg);
   if(InpAlertPush)  SendNotification(msg);
   if(InpAlertEmail) SendMail("MT5 Reversal signal", msg);
}

//+------------------------------------------------------------------+
//| Process one fully-closed bar (chronological index i)             |
//+------------------------------------------------------------------+
void ProcessBar(const int i, const bool isLiveBar,
                const datetime &time[], const double &high[], const double &low[])
{
   SellBuffer[i] = 0.0;
   BuyBuffer[i]  = 0.0;

   //================= SELL / top =================
   if(InpEnableSell)
   {
      if(g_peakBar < 0 || high[i] > g_peakHigh)
      {
         // New (higher) top -> old top invalidated, restart the count
         g_peakHigh      = high[i];
         g_peakBar       = i;
         g_barsSincePeak = 0;
         g_sellFired     = false;
      }
      else
      {
         // This candle stayed below the marked high
         g_barsSincePeak++;
         if(!g_sellFired && g_barsSincePeak >= InpBarsToConfirm)
         {
            g_sellFired = true;
            SellBuffer[i] = high[i] + InpArrowOffsetPts * _Point;
            DrawLevel("Sell", time[g_peakBar], time[i], g_peakHigh, clrTomato);
            if(isLiveBar && time[i] != g_lastSellAlert)
            {
               g_lastSellAlert = time[i];
               FireAlert(true, time[i], g_peakHigh);
            }
         }
      }
   }

   //================= BUY / bottom =================
   if(InpEnableBuy)
   {
      if(g_troughBar < 0 || low[i] < g_troughLow)
      {
         // New (lower) bottom -> old bottom invalidated, restart the count
         g_troughLow        = low[i];
         g_troughBar        = i;
         g_barsSinceTrough  = 0;
         g_buyFired         = false;
      }
      else
      {
         // This candle stayed above the marked low
         g_barsSinceTrough++;
         if(!g_buyFired && g_barsSinceTrough >= InpBarsToConfirm)
         {
            g_buyFired = true;
            BuyBuffer[i] = low[i] - InpArrowOffsetPts * _Point;
            DrawLevel("Buy", time[g_troughBar], time[i], g_troughLow, clrDodgerBlue);
            if(isLiveBar && time[i] != g_lastBuyAlert)
            {
               g_lastBuyAlert = time[i];
               FireAlert(false, time[i], g_troughLow);
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Calculation                                                      |
//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
{
   if(rates_total < 2)
      return(0);

   // Full (re)build: clear state and all buffers
   if(prev_calculated == 0)
   {
      ResetState();
      ArrayInitialize(SellBuffer, 0.0);
      ArrayInitialize(BuyBuffer,  0.0);
   }

   // The last bar (rates_total-1) is still forming; only process closed bars.
   int lastClosed = rates_total - 2;

   // Was this call triggered after the full history was already built?
   // If so, the newest closed bar may alert; during the initial history
   // build we stay silent.
   bool liveSession = (prev_calculated > 0);

   for(int i = g_computedBars; i <= lastClosed; i++)
   {
      bool isLiveBar = (liveSession && i == lastClosed);
      ProcessBar(i, isLiveBar, time, high, low);
      g_computedBars = i + 1;
   }

   return(rates_total);
}
//+------------------------------------------------------------------+
