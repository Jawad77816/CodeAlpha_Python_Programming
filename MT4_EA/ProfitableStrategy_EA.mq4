//+------------------------------------------------------------------+
//|                                        ProfitableStrategy_EA.mq4  |
//|   EA that trades the signals of the "ProfitableStrategy_11"       |
//|   (ZigZag-style) custom indicator via iCustom().                  |
//|                                                                    |
//|   CONFIRMED from the Data Window:                                  |
//|     Buffer 0 (ZigZag line) = BOTTOM / Lime  -> BUY                 |
//|     Buffer 1 (Value 2)     = TOP    / Red   -> SELL                |
//|     Empty slots read as 0.0000 (treated as "no signal")           |
//|     Indicator params shown: ZigZag(156,5,2)                        |
//|                                                                    |
//|   TP: fixed distance (default 10.0 price units)                   |
//|       gold BUY 4000 => TP 4010 ; SELL 4000 => TP 3990             |
//|                                                                    |
//|   Because ZigZag plots a pivot BACK at the extreme candle, this   |
//|   EA scans a window of recent bars for a NEW marker instead of    |
//|   only the last closed bar. See the README.                       |
//+------------------------------------------------------------------+
#property copyright "Generated by Claude Code"
#property link      ""
#property version   "1.10"
#property strict

//=== Trade settings ================================================
input double  LotSize            = 0.01;   // Fixed lot size
input double  TP_Distance        = 10.0;   // Take-Profit distance in PRICE units (10.0 = $10 on gold)
input double  SL_Distance        = 0.0;    // Stop-Loss distance in PRICE units (0 = no SL)
input int     Slippage           = 30;     // Max slippage (in points)
input int     MagicNumber        = 77811;  // Unique EA id for its own orders
input int     MaxOpenPositions   = 1;      // Max simultaneous positions opened by this EA (0 = unlimited)

//=== Indicator settings ============================================
// File name WITHOUT .ex4, located in MQL4\Indicators (or a subfolder).
input string  IndicatorName      = "ProfitableStrategy_11";

// The three values shown in the tooltip: ZigZag(156,5,2). Passed to
// iCustom in this order. If the EA never trades, a parameter mismatch
// here is the first thing to check.
input int     InpDepth           = 156;    // 1st indicator input (Depth)
input int     InpDeviation       = 5;      // 2nd indicator input (Deviation)
input int     InpBackstep        = 2;      // 3rd indicator input (Backstep)

// Buffer indexes (CONFIRMED from Data Window).
input int     BuyBufferIndex     = 0;      // Bottom / BUY markers (Lime)
input int     SellBufferIndex    = 1;      // Top / SELL markers (Red)

//=== Signal settings ===============================================
input int     ScanBars           = 60;     // How many recent bars to scan for a new marker
input int     ConfirmBars        = 2;      // Pivot must be this many closed bars old (anti-repaint)
input bool    TradeOnlyNewSignals= true;   // On attach, ignore existing markers; trade only future ones
input bool    CloseOppositeFirst = false;  // Close opposite EA trades when a new signal appears

//=== Diagnostics ===================================================
input bool    DebugMode          = true;   // Print buffer reads to the Experts log each new bar

//=== Internal state ================================================
datetime g_lastBuySignalTime  = 0;   // Bar time of the last BUY marker we traded
datetime g_lastSellSignalTime = 0;   // Bar time of the last SELL marker we traded

//+------------------------------------------------------------------+
//| Read one buffer value of the custom indicator at a given shift   |
//+------------------------------------------------------------------+
double ReadIndicator(int bufferIndex, int shift)
{
   return iCustom(Symbol(), Period(), IndicatorName,
                  InpDepth, InpDeviation, InpBackstep,
                  bufferIndex, shift);
}

//+------------------------------------------------------------------+
//| Is this buffer value a real marker (not empty / zero)?           |
//+------------------------------------------------------------------+
bool IsMarker(double value)
{
   if(value == EMPTY_VALUE)       return false;
   if(value == 0.0)               return false;
   if(!MathIsValidNumber(value))  return false;
   return true;
}

//+------------------------------------------------------------------+
//| Find the bar time of the most recent marker of one buffer within |
//| the scan window. Returns 0 if none found.                        |
//+------------------------------------------------------------------+
datetime NewestMarkerTime(int bufferIndex)
{
   int startShift = 1 + ConfirmBars;             // skip live + confirmation bars
   int endShift   = ScanBars + ConfirmBars;
   if(endShift >= Bars) endShift = Bars - 1;

   for(int s = startShift; s <= endShift; s++)   // nearest (newest) first
   {
      double v = ReadIndicator(bufferIndex, s);
      if(IsMarker(v))
         return Time[s];
   }
   return 0;
}

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   // Baseline so we don't fire on markers that already exist at attach time.
   if(TradeOnlyNewSignals)
   {
      g_lastBuySignalTime  = NewestMarkerTime(BuyBufferIndex);
      g_lastSellSignalTime = NewestMarkerTime(SellBufferIndex);
   }

   Print("ProfitableStrategy_EA v1.10 started on ", Symbol(), " ", Period(), "min. ",
         "Indicator=", IndicatorName, " (", InpDepth, ",", InpDeviation, ",", InpBackstep, "). ",
         "Baseline BUY=", TimeToString(g_lastBuySignalTime),
         " SELL=", TimeToString(g_lastSellSignalTime));
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Position helpers                                                 |
//+------------------------------------------------------------------+
int CountMyPositions()
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol())                   continue;
      if(OrderMagicNumber() != MagicNumber)           continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL) continue;
      count++;
   }
   return count;
}

void CloseByType(int orderType)
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol())                   continue;
      if(OrderMagicNumber() != MagicNumber)           continue;
      if(OrderType() != orderType)                    continue;

      double price = (orderType == OP_BUY) ? Bid : Ask;
      if(!OrderClose(OrderTicket(), OrderLots(), price, Slippage, clrYellow))
         Print("OrderClose failed, error: ", GetLastError());
   }
}

double NormPrice(double price) { return NormalizeDouble(price, Digits); }

//+------------------------------------------------------------------+
//| Open a trade with the configured TP / SL                         |
//+------------------------------------------------------------------+
void OpenTrade(int orderType)
{
   double price = (orderType == OP_BUY) ? Ask : Bid;
   double tp = 0.0, sl = 0.0;

   if(TP_Distance > 0.0)
      tp = (orderType == OP_BUY) ? price + TP_Distance : price - TP_Distance;
   if(SL_Distance > 0.0)
      sl = (orderType == OP_BUY) ? price - SL_Distance : price + SL_Distance;

   // Respect the broker's minimum stop distance.
   double minStop = MarketInfo(Symbol(), MODE_STOPLEVEL) * Point;
   if(tp != 0.0 && MathAbs(tp - price) < minStop)
      tp = (orderType == OP_BUY) ? price + minStop : price - minStop;
   if(sl != 0.0 && MathAbs(sl - price) < minStop)
      sl = (orderType == OP_BUY) ? price - minStop : price + minStop;

   string comment = (orderType == OP_BUY) ? "PS_BUY" : "PS_SELL";
   color  arrow   = (orderType == OP_BUY) ? clrLime : clrRed;

   int ticket = OrderSend(Symbol(), orderType, LotSize, NormPrice(price),
                          Slippage, NormPrice(sl), NormPrice(tp),
                          comment, MagicNumber, 0, arrow);

   if(ticket < 0)
      Print("OrderSend FAILED (", comment, "), error: ", GetLastError(),
            " price=", price, " tp=", tp, " sl=", sl);
   else
      Print("OPENED ", comment, " ticket=", ticket, " price=", price, " tp=", tp, " sl=", sl);
}

//+------------------------------------------------------------------+
//| Main tick handler - acts once per new bar                        |
//+------------------------------------------------------------------+
void OnTick()
{
   static datetime lastBarTime = 0;
   if(Time[0] == lastBarTime) return;   // only evaluate on a new (closed) bar
   lastBarTime = Time[0];

   datetime newBuyTime  = NewestMarkerTime(BuyBufferIndex);
   datetime newSellTime = NewestMarkerTime(SellBufferIndex);

   if(DebugMode)
      Print("Scan: newestBUY=", TimeToString(newBuyTime),
            " (last traded ", TimeToString(g_lastBuySignalTime), ") | newestSELL=",
            TimeToString(newSellTime),
            " (last traded ", TimeToString(g_lastSellSignalTime), ")");

   bool roomToTrade = (MaxOpenPositions == 0 || CountMyPositions() < MaxOpenPositions);

   //--- BUY (bottom / Lime / buffer 0) ---
   if(newBuyTime > 0 && newBuyTime > g_lastBuySignalTime)
   {
      if(roomToTrade)
      {
         if(CloseOppositeFirst) CloseByType(OP_SELL);
         OpenTrade(OP_BUY);
      }
      g_lastBuySignalTime = newBuyTime;   // mark handled either way
   }

   //--- SELL (top / Red / buffer 1) ---
   if(newSellTime > 0 && newSellTime > g_lastSellSignalTime)
   {
      // re-check room (a buy may have just filled this bar)
      roomToTrade = (MaxOpenPositions == 0 || CountMyPositions() < MaxOpenPositions);
      if(roomToTrade)
      {
         if(CloseOppositeFirst) CloseByType(OP_BUY);
         OpenTrade(OP_SELL);
      }
      g_lastSellSignalTime = newSellTime;
   }
}
//+------------------------------------------------------------------+
