//+------------------------------------------------------------------+
//|                                        ProfitableStrategy_EA.mq4  |
//|   EA that trades the signals of the "ProfitableStrategy_11"       |
//|   (ZigZag-style) custom indicator via iCustom().                  |
//|                                                                    |
//|   LOGIC                                                            |
//|     - When the indicator paints a BOTTOM (Lime / buffer 0)  -> BUY |
//|     - When the indicator paints a TOP    (Red  / buffer 1)  -> SELL|
//|     - Fixed lot (default 0.01)                                     |
//|     - Fixed Take-Profit distance in price units                   |
//|       (default 10.0 -> gold BUY 4000 => TP 4010, SELL 4000 => 3990)|
//|                                                                    |
//|   NOTE ON REPAINTING: see the README that ships with this EA.      |
//|   ZigZag-type indicators CAN repaint their most recent leg, so by  |
//|   default this EA only acts on CLOSED (confirmed) bars and lets    |
//|   you add extra confirmation bars.                                 |
//+------------------------------------------------------------------+
#property copyright "Generated by Claude Code"
#property link      ""
#property version   "1.00"
#property strict

//=== Trade settings ================================================
input double  LotSize            = 0.01;   // Fixed lot size
input double  TP_Distance        = 10.0;   // Take-Profit distance in PRICE units (10.0 = $10 on gold)
input double  SL_Distance        = 0.0;    // Stop-Loss distance in PRICE units (0 = no SL)
input int     Slippage           = 30;     // Max slippage (in points)
input int     MagicNumber        = 77811;  // Unique EA id for its own orders
input int     MaxOpenPositions   = 1;      // Max simultaneous positions opened by this EA (0 = unlimited)

//=== Indicator settings ============================================
// The indicator file name WITHOUT the .ex4 extension. It must be in
// MQL4\Indicators (or a subfolder, e.g. "MyFolder\\ProfitableStrategy_11").
input string  IndicatorName      = "ProfitableStrategy_11";

// The three values shown in the indicator tooltip: ZigZag(156,5,2).
// These are passed to iCustom in the SAME ORDER the indicator expects.
// If the EA produces no trades, the most likely cause is a parameter
// mismatch here - adjust to match the indicator's own inputs exactly.
input int     InpDepth           = 156;    // 1st indicator input (Depth)
input int     InpDeviation       = 5;      // 2nd indicator input (Deviation)
input int     InpBackstep        = 2;      // 3rd indicator input (Backstep)

// Buffer indexes (from the Colors tab: 0 = Lime = buy, 1 = Red = sell).
input int     BuyBufferIndex     = 0;      // Buffer that holds BOTTOM/BUY markers
input int     SellBufferIndex    = 1;      // Buffer that holds TOP/SELL markers

//=== Signal settings ===============================================
input int     SignalShift        = 1;      // Bar to read the signal from (1 = last CLOSED bar; 0 = current, repaints!)
input int     ConfirmBars        = 0;      // Extra bars the pivot must survive before trading (anti-repaint)
input bool    OneTradePerSignal  = true;   // Only one trade per indicator arrow
input bool    CloseOppositeFirst = false;  // Close opposite EA trades when a new signal appears

//=== Internal state ================================================
datetime g_lastBuySignalTime  = 0;   // Time of the bar whose BUY signal we already traded
datetime g_lastSellSignalTime = 0;   // Time of the bar whose SELL signal we already traded

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   Print("ProfitableStrategy_EA started. Reading indicator: ", IndicatorName,
         " (", InpDepth, ",", InpDeviation, ",", InpBackstep, ")");
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Read one buffer value of the custom indicator at a given shift   |
//+------------------------------------------------------------------+
double ReadIndicator(int bufferIndex, int shift)
{
   // Parameter order passed to the indicator: Depth, Deviation, Backstep.
   // Adjust here (and in the inputs above) if your indicator differs.
   return iCustom(Symbol(), Period(), IndicatorName,
                  InpDepth, InpDeviation, InpBackstep,
                  bufferIndex, shift);
}

//+------------------------------------------------------------------+
//| Is this buffer value an actual marker (not empty/zero)?          |
//+------------------------------------------------------------------+
bool IsMarker(double value)
{
   if(value == EMPTY_VALUE) return false;
   if(value == 0.0)         return false;
   // Guard against uninitialised / absurd values.
   if(!MathIsValidNumber(value)) return false;
   return true;
}

//+------------------------------------------------------------------+
//| Count positions this EA currently has open                       |
//+------------------------------------------------------------------+
int CountMyPositions(int typeFilter = -1)
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol())                   continue;
      if(OrderMagicNumber() != MagicNumber)           continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL) continue;
      if(typeFilter != -1 && OrderType() != typeFilter)   continue;
      count++;
   }
   return count;
}

//+------------------------------------------------------------------+
//| Close EA positions of a given type (OP_BUY / OP_SELL)            |
//+------------------------------------------------------------------+
void CloseByType(int orderType)
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES)) continue;
      if(OrderSymbol() != Symbol())                   continue;
      if(OrderMagicNumber() != MagicNumber)           continue;
      if(OrderType() != orderType)                    continue;

      double price = (orderType == OP_BUY) ? Bid : Ask;
      if(!OrderClose(OrderTicket(), OrderLots(), price, Slippage, clrYellow))
         Print("OrderClose failed, error: ", GetLastError());
   }
}

//+------------------------------------------------------------------+
//| Normalize a price to the symbol's tick size                      |
//+------------------------------------------------------------------+
double NormPrice(double price)
{
   return NormalizeDouble(price, Digits);
}

//+------------------------------------------------------------------+
//| Open a trade with the configured TP / SL                         |
//+------------------------------------------------------------------+
void OpenTrade(int orderType)
{
   double price = (orderType == OP_BUY) ? Ask : Bid;
   double tp = 0.0, sl = 0.0;

   if(TP_Distance > 0.0)
      tp = (orderType == OP_BUY) ? price + TP_Distance : price - TP_Distance;

   if(SL_Distance > 0.0)
      sl = (orderType == OP_BUY) ? price - SL_Distance : price + SL_Distance;

   // Respect the broker's minimum stop distance.
   double minStop = MarketInfo(Symbol(), MODE_STOPLEVEL) * Point;
   if(tp != 0.0 && MathAbs(tp - price) < minStop)
      tp = (orderType == OP_BUY) ? price + minStop : price - minStop;
   if(sl != 0.0 && MathAbs(sl - price) < minStop)
      sl = (orderType == OP_BUY) ? price - minStop : price + minStop;

   string comment = (orderType == OP_BUY) ? "PS_BUY" : "PS_SELL";
   color  arrow   = (orderType == OP_BUY) ? clrLime : clrRed;

   int ticket = OrderSend(Symbol(), orderType, LotSize, NormPrice(price),
                          Slippage, NormPrice(sl), NormPrice(tp),
                          comment, MagicNumber, 0, arrow);

   if(ticket < 0)
      Print("OrderSend failed (", comment, "), error: ", GetLastError());
   else
      Print("Opened ", comment, " ticket=", ticket, " price=", price, " tp=", tp, " sl=", sl);
}

//+------------------------------------------------------------------+
//| Main tick handler                                                |
//+------------------------------------------------------------------+
void OnTick()
{
   // Act once per bar: we only evaluate when a new bar opens, so signals
   // are read on CLOSED bars and we avoid firing on every tick.
   static datetime lastBarTime = 0;
   if(Time[0] == lastBarTime) return;
   lastBarTime = Time[0];

   // The bar that carries the signal we want to confirm.
   int shift = SignalShift + ConfirmBars;
   if(shift >= Bars) return;

   datetime signalBarTime = Time[shift];

   double buyVal  = ReadIndicator(BuyBufferIndex,  shift);
   double sellVal = ReadIndicator(SellBufferIndex, shift);

   bool buySignal  = IsMarker(buyVal);
   bool sellSignal = IsMarker(sellVal);

   //--- BUY (bottom / Lime) ---
   if(buySignal)
   {
      bool alreadyTraded = (OneTradePerSignal && signalBarTime == g_lastBuySignalTime);
      bool roomToTrade   = (MaxOpenPositions == 0 || CountMyPositions() < MaxOpenPositions);

      if(!alreadyTraded && roomToTrade)
      {
         if(CloseOppositeFirst) CloseByType(OP_SELL);
         OpenTrade(OP_BUY);
         g_lastBuySignalTime = signalBarTime;
      }
   }

   //--- SELL (top / Red) ---
   if(sellSignal)
   {
      bool alreadyTraded = (OneTradePerSignal && signalBarTime == g_lastSellSignalTime);
      bool roomToTrade   = (MaxOpenPositions == 0 || CountMyPositions() < MaxOpenPositions);

      if(!alreadyTraded && roomToTrade)
      {
         if(CloseOppositeFirst) CloseByType(OP_BUY);
         OpenTrade(OP_SELL);
         g_lastSellSignalTime = signalBarTime;
      }
   }
}
//+------------------------------------------------------------------+
